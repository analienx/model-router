{
  "_readme": "Copy of this file lives at ~/.claude-router/router.config.json after install. Keys starting with _ are ignored. Every field is explained in SETUP.md, section 5.",
  "version": 1,
  "foundry": {
    "resource": "YOUR-FOUNDRY-RESOURCE-NAME",
    "base_url": "",
    "auth": "entra",
    "api_key_env": "FOUNDRY_API_KEY",
    "prompt_caching_1h": false
  },
  "tiers": {
    "fast":     { "model_id": "claude-haiku-5-5",  "deployment": "claude-haiku-5-5" },
    "standard": { "model_id": "claude-sonnet-5-5", "deployment": "claude-sonnet-5-5" },
    "deep":     { "model_id": "claude-opus-5-5",   "deployment": "claude-opus-5-5" }
  },
  "launcher": {
    "max_retries": 3,
    "fallback_models": [],
    "extra_args": []
  },
  "judge": {
    "chain": [
      { "backend": "subscription", "model": "sonnet", "effort": "max",  "timeout_s": 90 },
      { "backend": "foundry",      "model": "sonnet", "effort": "high", "timeout_s": 45 },
      { "backend": "rules" }
    ],
    "min_confidence": 0.6,
    "max_prompt_chars": 6000,
    "include_git_signals": true,
    "sticky_phrases": ["yes", "y", "yep", "yeah", "ok", "okay", "sure", "continue", "go on", "go ahead", "do it", "proceed", "please do", "sounds good", "lgtm", "thanks", "thank you", "next", "go"],
    "escalate_phrases": ["try again", "still failing", "still fails", "still broken", "still not working", "still wrong", "didn't work", "did not work", "doesn't work", "does not work", "not working", "same error", "same problem", "it failed", "failed again", "again"],
    "claude_path": ""
  },
  "guard": {
    "main_edit_budget": { "fast": 40, "standard": 10, "deep": 0 },
    "other_subagent_edit_lines": 20
  },
  "logging": {
    "enabled": true,
    "log_prompt_text": false,
    "log_judge_details": false
  },
  "ui": {
    "banner": "full",
    "verdict_line": true
  }
}
